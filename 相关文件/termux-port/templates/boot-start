#!/data/data/com.termux/files/usr/bin/sh
# Termux:Boot 启动脚本：install-termux.sh 会把 @HOME@ 替换成实际家目录，
# 安装到 ~/.termux/boot/00-tvstation，并 chmod 755。
#
# 需要装 Termux:Boot，并且安装后先手动点开一次 Termux:Boot 图标（否则 Android
# 不会允许它开机自启）。脚本按文件名排序执行，00- 保证它最早跑。

export PREFIX=/data/data/com.termux/files/usr
export HOME=@HOME@
export PATH="$PREFIX/bin:$PATH"
export SVDIR="$PREFIX/var/service"
export LOGDIR="$PREFIX/var/log"

# 开机后 Wi-Fi 往往还没连上。等 wlan0 拿到 IPv4，最多 120 秒。
# 等不到也继续往下走：station.py 在运行中会自己重试 adb/B站接口。
i=0
while [ "$i" -lt 60 ]; do
  if ip -4 addr show wlan0 2>/dev/null | grep -q 'inet '; then
    break
  fi
  i=$((i + 1))
  sleep 2
done

# 拿 partial wakelock，防止息屏后 CPU/网络被 Android 挂起。
termux-wake-lock 2>/dev/null || true

# 启动 termux-services 的 runit 守护进程（已经在跑时这条会失败，忽略）。
service-daemon start >/dev/null 2>&1 || true
sleep 2

# 拉起 tvstation 和 tvcontrol；如果服务被 sv down 过，sv up 会重新启动它。
sv up tvstation 2>/dev/null || true
sv up tvcontrol 2>/dev/null || true
